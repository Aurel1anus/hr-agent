# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Backend virtual environments and Python artifacts
backend/.venv/
backend/__pycache__/
backend/**/*.py[cod]
backend/**/*.so

# Local SQLite databases
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/data/

# Environment secrets (keep example files tracked)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env.*.local

# Test, coverage, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# IDE and OS metadata
.codegraph/
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
