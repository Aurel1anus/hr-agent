DATABASE_URL=sqlite:///./hr_recruiting.db
LOCAL_STORAGE_ROOT=./data
MAX_RESUME_SIZE_MB=10
MAX_RESUME_PAGES=30

AI_PROVIDER=deepseek
AI_PROTOCOL=openai
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=60
# DeepSeek V4 起 thinking 默认开启；默认关闭以保证响应确定性与成本可控
AI_DISABLE_THINKING=1
# 仅在 AI_DISABLE_THINKING=0 时生效：low / high / max
AI_THINKING_EFFORT=high

# Multiple origins can be separated with commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
